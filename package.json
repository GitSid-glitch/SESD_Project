{
  "name": "smart-project-management-system",
  "version": "1.0.0",
  "description": "Backend-focused full stack project management system for SESD.",
  "main": "dist/src/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.frontend.json",
    "start": "npm run build && node dist/src/server.js",
    "dev": "npm run build && node --watch dist/src/server.js",
    "seed": "npm run build && node dist/src/scripts/seed.js",
    "test": "npm run build && node --test dist/test/*.js"
  },
  "keywords": [
    "sesd",
    "project-management",
    "node"
  ],
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "license": "MIT"
}
